            "meta.embedded.line variable.legacy.builtin.python", "meta.interpolation variable.legacy.builtin.python",
            "meta.embedded.expression variable.legacy.builtin.python",
            "meta.embedded.interpolation variable.legacy.builtin.python", "emphasis", "meta.embedded.line emphasis",
            "meta.interpolation emphasis", "meta.embedded.expression emphasis", "meta.embedded.interpolation emphasis",
            "strong", "meta.embedded.line strong", "meta.interpolation strong", "meta.embedded.expression strong",
            "meta.embedded.interpolation strong", "variable.other.enummember",
            "meta.embedded.line variable.other.enummember", "meta.interpolation variable.other.enummember",
            "meta.embedded.expression variable.other.enummember",
            "meta.embedded.interpolation variable.other.enummember", "constant.regexp",
            "meta.embedded.line constant.regexp", "meta.interpolation constant.regexp",
            "meta.embedded.expression constant.regexp", "meta.embedded.interpolation constant.regexp",
            "entity.name.tag", "meta.embedded.line entity.name.tag", "meta.interpolation entity.name.tag",
            "meta.embedded.expression entity.name.tag", "meta.embedded.interpolation entity.name.tag",
            "entity.name.selector", "meta.embedded.line entity.name.selector",
