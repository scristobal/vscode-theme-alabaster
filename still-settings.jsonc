        "macro.declaration": "#E5C76B",
        "macro.definition": "#E5C76B",
        "variable.callable.declaration": "#E5C76B",
        "variable.callable.definition": "#E5C76B",
        "newOperator": "#808080",
        "stringLiteral": "#A8CF80",
        "customLiteral": "#A8CF80",
        "numberLiteral": "#A8CF80"
      }
    },
    "[Light 2026]": {
      "enabled": true,
      "rules": {
        "*": {"foreground": "#202020", "fontStyle": ""},
        "comment": "#8250A0",
        "string": "#3C6D2C",
        "regexp": "#3C6D2C",
        "number": "#3C6D2C",
        "boolean": "#3C6D2C",
        "character": "#3C6D2C",
