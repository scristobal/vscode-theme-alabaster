          "settings": {"foreground": "#7EB6E8", "fontStyle": ""}
        },
        {
          "scope": [
            "invalid", "markup.deleted", "invalid.broken", "invalid.deprecated", "invalid.illegal",
            "invalid.unimplemented"
          ],
          "settings": {"foreground": "#EC8B8B", "fontStyle": ""}
        },
        {
          "name": "Punctuation and symbolic operators",
          "scope": [
            "punctuation", "keyword.operator", "meta.brace", "storage.type.function.arrow"
          ],
          "settings": {"foreground": "#808080", "fontStyle": ""}
        },
        {
          "name": "Word operators are ordinary words",
          "scope": [
            "keyword.operator.new", "keyword.operator.expression", "keyword.operator.word",
            "keyword.operator.logical.python"
          ],
          "settings": {"foreground": "#BBBEBF", "fontStyle": ""}
        },
        {
          "name": "Literals share one color",
          "scope": [
            "string", "constant.numeric", "constant.language", "constant.character", "constant.other.symbol",
            "constant.keyword", "string punctuation.definition.string", "string punctuation.definition.regex",
            "string.regexp punctuation", "string.regexp keyword.operator"
          ],
          "settings": {"foreground": "#A8CF80", "fontStyle": ""}
        },
        {
          "name": "Expressions embedded in strings remain code",
          "scope": [
            "meta.embedded", "meta.interpolation", "meta.template.expression"
          ],
          "settings": {"foreground": "#BBBEBF", "fontStyle": ""}
        },
        {
          "name": "Binding declarations (only where the grammar identifies them)",
          "scope": [
            "meta.definition.variable", "meta.definition.property", "variable.parameter"
          ],
          "settings": {"foreground": "#7EB6E8", "fontStyle": ""}
        },
        {
          "name": "Named declarations (never calls or type references)",
          "scope": [
            "meta.definition.function entity.name.function", "meta.definition.method entity.name.function",
            "entity.name.function.python", "meta.function.definition.rust entity.name.function",
            "entity.name.type.class.ts", "entity.name.type.class.js", "entity.name.type.interface.ts",
            "entity.name.type.alias.ts", "entity.name.type.enum.ts", "entity.name.type.class.python",
            "entity.name.type.struct.rust", "entity.name.type.enum.rust", "entity.name.type.trait.rust",
            "entity.name.type.declaration.rust", "entity.global.clojure"
          ],
          "settings": {"foreground": "#E5C76B", "fontStyle": ""}
        },
        {
          "name": "Comments deserve attention, including their delimiters",
          "scope": [
            "comment", "punctuation.definition.comment", "comment punctuation"
          ],
          "settings": {"foreground": "#C49BE0", "fontStyle": ""}
        },
        {
          "name": "Disabled code, when explicitly identified by the grammar",
          "scope": [
            "comment.block.discard", "comment.block.ignored", "comment.block.inactive"
          ],
          "settings": {"foreground": "#808080", "fontStyle": ""}
        },
        {
          "name": "Invalid syntax",
          "scope": "invalid",
          "settings": {"foreground": "#EC8B8B", "fontStyle": ""}
        },
        {
          "name": "Document headings",
          "scope": "markup.heading",
          "settings": {"foreground": "#E5C76B", "fontStyle": ""}
        },
        {
          "name": "Document links",
          "scope": [
            "markup.underline.link", "string.other.link"
          ],
          "settings": {"foreground": "#7EB6E8", "fontStyle": ""}
        },
        {
          "name": "Diff additions",
          "scope": "markup.inserted",
          "settings": {"foreground": "#A8CF80", "fontStyle": ""}
        },
        {
          "name": "Diff removals",
          "scope": "markup.deleted",
          "settings": {"foreground": "#EC8B8B", "fontStyle": ""}
        },
        {
          "name": "Diff context",
          "scope": [
            "meta.diff.header", "meta.diff.range", "meta.diff.index"
          ],
          "settings": {"foreground": "#808080", "fontStyle": ""}
        }
      ]
    },
    "[Light 2026]": {
      "textMateRules": [
        {
          "scope": [
            "meta.embedded", "source.groovy.embedded", "meta.embedded.line source.groovy.embedded",
