        "punctuation": "#767676",
        "escapeSequence": "#3C6D2C",
        "formatSpecifier": "#3C6D2C",
        "invalidEscapeSequence": "#B64343",
        "variable.declaration": "#1F6FAA",
        "variable.definition": "#1F6FAA",
        "parameter.declaration": "#1F6FAA",
        "parameter.definition": "#1F6FAA",
        "property.declaration": "#1F6FAA",
        "property.definition": "#1F6FAA",
        "typeParameter.declaration": "#1F6FAA",
        "typeParameter.definition": "#1F6FAA",
        "enumMember.declaration": "#1F6FAA",
        "enumMember.definition": "#1F6FAA",
        "function.declaration": "#8A6500",
        "function.definition": "#8A6500",
        "method.declaration": "#8A6500",
        "method.definition": "#8A6500",
        "class.declaration": "#8A6500",
        "class.definition": "#8A6500",
        "type.declaration": "#8A6500",
