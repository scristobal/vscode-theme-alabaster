        "invalidEscapeSequence": "#EC8B8B",
        "variable.declaration": "#7EB6E8",
        "variable.definition": "#7EB6E8",
        "parameter.declaration": "#7EB6E8",
        "parameter.definition": "#7EB6E8",
        "property.declaration": "#7EB6E8",
