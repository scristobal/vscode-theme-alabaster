{
	"name": "still-theme",
	"displayName": "Still",
	"description": "VS Code Dark 2026 and Light 2026 with minimal, purposeful syntax highlighting.",
	"version": "0.6.0",
	"publisher": "scristobal",
	"author": {
		"name": "Samuel Cristobal",
		"url": "https://github.com/scristobal"
	},
	"license": "MIT",
	"private": true,
	"engines": {
		"vscode": "^1.142.0",
		"node": ">=22"
	},
	"categories": [
		"Themes"
	],
	"keywords": [
		"theme",
		"dark",
		"light",
		"minimal",
		"syntax",
		"alabaster"
	],
	"icon": "icon.png",
	"files": [
		"themes/**",
		"assets/**",
		"icon.png",
		"README.md",
		"CHANGELOG.md",
		"UPSTREAM_CHANGELOG.md",
		"LICENSE.txt"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/scristobal/vscode-theme-alabaster.git"
	},
	"bugs": {
		"url": "https://github.com/scristobal/vscode-theme-alabaster/issues"
	},
	"homepage": "https://github.com/scristobal/vscode-theme-alabaster#readme",
	"scripts": {
		"build": "node scripts/build-themes.mjs",
		"check": "node scripts/build-themes.mjs --check",
		"vscode:prepublish": "npm run build && npm run check && npm test",
		"package": "vsce package --no-dependencies --no-rewrite-relative-links --no-gitHubIssueLinking",
		"test": "node tests/highlighting.test.mjs"
	},
	"devDependencies": {
		"@vscode/vsce": "4.0.0",
		"vscode-oniguruma": "2.0.1",
		"vscode-textmate": "9.3.2"
	},
	"contributes": {
		"themes": [
			{
				"label": "Still Dark",
				"uiTheme": "vs-dark",
				"path": "./themes/still-dark-color-theme.json"
			},
			{
				"label": "Still Light",
				"uiTheme": "vs",
				"path": "./themes/still-light-color-theme.json"
			}
		]
	}
}
